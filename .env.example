# 复制为 .env 后按需修改：cp .env.example .env
#
# 除"生成回答"需要 LLM 密钥外，其余能力（检索、摄取、评测、闸门）都可离线运行。
# 这里列出的值多数与代码默认值一致，只为方便按需覆盖。

# ---------- 应用 ----------
KUBEDOCS_LOG_LEVEL=INFO
KUBEDOCS_API_PORT=8080

# ---------- 存储 ----------
# 默认后端是 pgvector（Postgres + pgvector）：索引与全文检索在同一个库里，跨重启、跨副本共享。
# 数据库不可达时**降级**为本地 sqlite-vec（零外部进程）。降级在 /healthz 的 store / store_fallback、
# `kubedocs stats` 的「存储后端 X（配置 Y）」与 `⚠ 已降级：…`、以及服务日志里那条 WARNING 上可见。
# 代价：两个后端的索引存在不同位置，降级期间建的索引在 Postgres 恢复后**看不见**。
KUBEDOCS_INDEX_DIR=data/index
KUBEDOCS_STORE=pgvector
KUBEDOCS_DATABASE_URL=postgresql://kubedocs:kubedocs@127.0.0.1:5432/kubedocs
# 离线 / 单机不想装 Postgres 时显式换成本地后端（两者都是零外部进程）：
# KUBEDOCS_STORE=sqlite-vec        # SQLite + sqlite-vec 向量索引，本地档里更快的那个
# KUBEDOCS_STORE=sqlite            # numpy 暴力内积，最小依赖与性能对照
# 注意：pgvector 后端的全文检索路依赖 ParadeDB 镜像自带的 pg_search（真 BM25）；
# 镜像不带它时不会静默假装——日志会打 WARNING，`cli stats --verify` 退出码 3，
# 检索指标也确实会下降。可用镜像见 docker-compose.yml 的 db 服务。

# ---------- 切块（父子两层） ----------
# 检索用子块（进 BM25 与向量索引）、喂给模型用父块（一个标题小节，不进索引）。
# 这几个值只在**摄取时**生效：改完必须重建索引，否则索引里还是旧的那一套切法。
KUBEDOCS_CHUNK_MAX_CHARS=300         # 子块（检索单位）目标长度
KUBEDOCS_CHUNK_OVERLAP_CHARS=60      # 相邻子块的重叠，必须小于上一项
KUBEDOCS_CHUNK_MIN_CHARS=80          # 短于此的子块并入同一父块内的前一块
KUBEDOCS_CHUNK_PARENT_MAX_CHARS=3000 # 父块上限，超过就按段落边界拆成多个父块

# ---------- 嵌入 ----------
# bge=本地真实模型（默认）；hashing=确定性哈希向量，仅用于不下载模型的冒烟测试，
# 不能用于任何质量结论；api=远端嵌入接口。
KUBEDOCS_EMBEDDING_PROVIDER=bge
KUBEDOCS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KUBEDOCS_EMBEDDING_DIM=384
KUBEDOCS_EMBEDDING_BATCH_SIZE=64
# 模型下载源（受限网络下可用镜像站）
KUBEDOCS_HF_ENDPOINT=https://hf-mirror.com
# 模型已缓存后置 true，跳过联网校验。在访问不到 huggingface.co 的网络里，
# 这一步的联网校验会长时间挂起，设为 true 后载入只需不到 1 秒。
KUBEDOCS_HF_OFFLINE=false

# ---------- 会话状态 ----------
# 图编排的 checkpoint 落盘路径；留空表示仅内存态（进程重启即丢）。
# 若要跨重启续跑，建议指向索引目录之外的独立文件，例如 data/state/clinic_state.db。
# 它保存的是会话状态（含患者描述），不是病历。
KUBEDOCS_CLINIC_STATE_DB=

# ---------- 检索 ----------
KUBEDOCS_TOP_K=8                    # 最终返回条数
KUBEDOCS_RRF_K=60                   # RRF 融合的平滑常数
KUBEDOCS_FTS_CANDIDATE_K=50         # 全文路候选数
KUBEDOCS_DENSE_CANDIDATE_K=50       # 向量路候选数
KUBEDOCS_RERANK_ENABLE=false        # 交叉编码器重排（默认关，按需开启）
KUBEDOCS_RERANK_MODEL=BAAI/bge-reranker-base
KUBEDOCS_MAX_CONTEXT_CHARS=8000

# ---------- 大模型（唯一需要密钥的地方） ----------
# 模型名用 LiteLLM 格式：provider/model，例如 deepseek/deepseek-chat、openai/gpt-4o-mini
KUBEDOCS_LLM_MODEL=deepseek/deepseek-chat
KUBEDOCS_LLM_TEMPERATURE=0.1
KUBEDOCS_LLM_MAX_TOKENS=2000
KUBEDOCS_LLM_TIMEOUT=30
KUBEDOCS_LLM_MAX_RETRIES=2
# 日花费上限：达到上限后调用被拒绝，而不是继续计费
KUBEDOCS_LLM_DAILY_BUDGET_USD=5.0
# 可选：逗号分隔的备用模型，主模型失败时依次回退
# KUBEDOCS_LLM_FALLBACKS=openai/gpt-4o-mini

# 供应商密钥：只填你要用的那个
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 可观测 ----------
# 指标端点 /metrics 始终可用，不需要额外开关。
# OTel 追踪默认关（console 导出器会把 span 打到 stdout）；
# 打开后每次请求会产生一条 trace，可用 otlp 送到 collector。
KUBEDOCS_OTEL_ENABLE=false
KUBEDOCS_OTEL_EXPORTER=console      # console / otlp / none
# 走 otlp 时填这里；留空则用导出器默认端点
OTEL_EXPORTER_OTLP_ENDPOINT=
