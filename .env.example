# 复制为 .env 后按需填写：cp .env.example .env
#
# 设计原则：**除 LLM 供应商外，全栈可以离线跑起来**（检索、评测、闸门都不需要外网），
# 这样 CI 与面试官的本地复现都不依赖密钥。只有"生成回答"那一步需要 LLM。

# ---------- 应用 ----------
KUBEDOCS_ENV=local                  # local / ci / prod
KUBEDOCS_LOG_LEVEL=INFO
KUBEDOCS_API_PORT=8080

# ---------- 存储 ----------
# compose 里起的就是这套；本机直跑时把 host 换成 127.0.0.1
KUBEDOCS_DATABASE_URL=postgresql://kubedocs:kubedocs@db:5432/kubedocs
KUBEDOCS_REDIS_URL=redis://cache:6379/0

# ---------- 嵌入 ----------
# 本地模型（默认，可离线）；换成 API 时改 KUBEDOCS_EMBEDDING_PROVIDER=api
KUBEDOCS_EMBEDDING_PROVIDER=local
KUBEDOCS_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KUBEDOCS_EMBEDDING_DIM=384
# 国内直连 huggingface.co 不通、镜像通（实测），默认走镜像
HF_ENDPOINT=https://hf-mirror.com

# ---------- 检索 ----------
KUBEDOCS_TOP_K=8                    # 每路召回数
KUBEDOCS_RRF_K=60                   # RRF 平滑常数
KUBEDOCS_RERANK_ENABLE=false        # 交叉编码器重排（默认关：CPU 上较慢，按需开）
KUBEDOCS_RERANK_MODEL=BAAI/bge-reranker-base
KUBEDOCS_MAX_CONTEXT_CHARS=8000

# ---------- 大模型（唯一需要密钥的地方） ----------
# LiteLLM 的模型名格式：provider/model，例如 deepseek/deepseek-chat、openai/gpt-4o-mini
KUBEDOCS_LLM_MODEL=deepseek/deepseek-chat
KUBEDOCS_LLM_FALLBACKS=openai/gpt-4o-mini
KUBEDOCS_LLM_TEMPERATURE=0.1
KUBEDOCS_LLM_MAX_TOKENS=800
KUBEDOCS_LLM_TIMEOUT=30
KUBEDOCS_LLM_MAX_RETRIES=2
KUBEDOCS_LLM_DAILY_BUDGET_USD=5.0   # 成本上限：超过即拒绝（而不是悄悄烧钱）

# 供应商密钥（按需填，只填你要用的那个）
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ---------- 可观测 ----------
KUBEDOCS_OTEL_ENABLE=true
KUBEDOCS_OTEL_EXPORTER=console      # console / otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse:3000/api/public/otel
# Langfuse（可选，compose 里可起；留空则只走本地 span + Prometheus）
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse:3000
